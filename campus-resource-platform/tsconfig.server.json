{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/server",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": [
    "src/main.server.ts",
    "src/server.ts",
    "src/app/app.config.server.ts",
    "src/app/app.routes.server.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
