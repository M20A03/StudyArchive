rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User accounts collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Academic resources catalog
    match /resources/{resourceId} {
      allow read, write: if true;
    }

    // Fallback for document tree
    match /{document=**} {
      allow read, write: if true;
    }
  }
}